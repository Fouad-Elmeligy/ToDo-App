<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    >
        <!-- Title -->
        <TextView
            android:id="@+id/edit_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Edit Task"
            android:textColor="@color/item_week_day_color"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title Input -->
        <com.google.android.material.textfield.TextInputLayout

            android:id="@+id/title_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/edit_text"
            app:boxStrokeColor="@color/sky_blue"
            app:hintTextColor="@color/sky_blue"
            app:hintEnabled="true"
            app:errorEnabled="true">

            <EditText
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Task Title"
                android:textColor="@color/item_week_day_color"
                android:textColorHint="@color/item_week_day_color"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Details Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/details_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title_input_layout"
            app:boxStrokeColor="@color/sky_blue"
            app:hintTextColor="@color/sky_blue"
            app:hintEnabled="true"
            app:errorEnabled="true"
            >

            <EditText
                android:id="@+id/details_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Task Details"
                android:minLines="3"
                android:textColor="@color/item_week_day_color"
                android:textColorHint="@color/item_week_day_color"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Select Date Label -->
        <TextView
            android:id="@+id/select_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select date"
            android:textColor="@color/item_week_day_color"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/details_input_layout" />

        <!-- Selected Date -->
        <TextView
            android:id="@+id/selected_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27-6-2021"
            android:textColor="@color/edit_text_color"
            android:textSize="15sp"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/select_date_label" />

        <!-- Save Changes Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_changes_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:backgroundTint="@color/sky_blue"
            android:paddingHorizontal="50dp"
            android:paddingVertical="10dp"
            android:text="Save Changes"
            android:textColor="@color/white"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/selected_date"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="30dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


