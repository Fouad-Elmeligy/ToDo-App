<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bottom_sheet_color"
    >

    <TextView
        android:id="@+id/large_title_text"
        style="@style/large_title_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/add_new_task"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/title_textInput_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/large_title_text"
        android:layout_marginTop="20sp"
        android:layout_marginHorizontal="25sp"
        app:boxStrokeColor="@color/sky_blue"
        app:hintTextColor="@color/sky_blue"
        >
        <EditText

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titile"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/description_textInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/title_textInput_layout"
        android:layout_marginTop="20sp"
        app:boxStrokeColor="@color/sky_blue"
        app:hintTextColor="@color/sky_blue"
        android:layout_marginHorizontal="25sp"
        >
        <EditText

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:hint="Description"
            />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/selected_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/description_textInputLayout"
        app:layout_constraintStart_toStartOf="@id/description_textInputLayout"
        style="@style/medium_subTiltle_text_style"
        android:text="Select Date"
        android:layout_marginTop="25dp"
        />

    <TextView
        android:id="@+id/selected_time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/selected_date_label"
        app:layout_constraintStart_toStartOf="@id/description_textInputLayout"
        style="@style/medium_subTiltle_text_style"
        android:text="Select Time"
        android:layout_marginTop="25dp"
        />
    <TextView
        android:id="@+id/selected_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/description_textInputLayout"
        app:layout_constraintEnd_toEndOf="@id/description_textInputLayout"
        style="@style/edit_text_style"
        android:text="1/1/2025"
        android:textSize="18sp"
        android:layout_marginTop="25dp"
        />

    <TextView
        android:id="@+id/selected_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/selected_date_label"
        app:layout_constraintEnd_toEndOf="@id/description_textInputLayout"
        style="@style/edit_text_style"
        android:text="5 pm"
        android:textSize="18sp"
        android:layout_marginTop="25dp"
        />

    <Button
        android:id="@+id/add_todo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:backgroundTint="@color/sky_blue"
        android:layout_marginHorizontal="25dp"
        android:paddingVertical="15dp"
        android:text="Add"
        android:textSize="18dp"
        android:textStyle="bold"
        style="@style/large_title_style"
        android:textColor="@color/white"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selected_time" />

</androidx.constraintlayout.widget.ConstraintLayout>