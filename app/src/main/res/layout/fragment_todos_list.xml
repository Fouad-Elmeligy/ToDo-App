<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragments.ToDosList.TodosListFragment">
  <View
      android:id="@+id/toolbar_view"
      android:layout_width="match_parent"
      android:layout_height="80dp"
      android:background="@color/Light_Blue"
      app:layout_constraintTop_toTopOf="parent"

      />
  <com.kizitonwose.calendar.view.WeekCalendarView
    android:id="@+id/week_calender_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="35dp"
      app:cv_daySize="seventhWidth"
      app:cv_dayViewResource="@layout/item_week_day"
      app:cv_weekHeaderResource="@layout/item_week_header"
      app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
      android:orientation="horizontal"
      app:layout_constraintTop_toTopOf="parent"
      tools:listitem="@layout/item_week_day"

      />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tasks_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/week_calender_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        tools:listitem="@layout/item_task"
        />


</androidx.constraintlayout.widget.ConstraintLayout>